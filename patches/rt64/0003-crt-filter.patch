+// CRT look: scanlines on the console's native lines plus an RGB aperture
+// grille on the window's pixels. Both fade out when the window has too few
+// pixels per native line to draw them without aliasing.
+//
+// Each scanline shows the average colour across its whole native line. With
+// upscaling, content moves in steps finer than a native line; lighting it by
+// where it sits within the line made edges pulse (shimmer) while panning.
+
+// Average colour of native line `lineIndex` at horizontal position u.
+float3 NativeLineColor(float lineIndex, float u) {
+    float3 sum = float3(0.0f, 0.0f, 0.0f);
+    [unroll]
+    for (int i = 0; i < 4; i++) {
+        const float v = (lineIndex + (float(i) + 0.5f) / 4.0f) / gConstants.nativeResolution.y;
+        sum += SampleInput((float2(u, v) / gConstants.textureResolution) * gConstants.videoResolution).rgb;
+    }
+
+    return sum * 0.25f;
+}
+
+float3 ApplyCRT(float3 color, float2 uv, float2 pos) {
+    const float strength = saturate(gConstants.crtStrength);
+    const float2 nativePos = uv * gConstants.nativeResolution;
+    const float2 nativeStep = fwidth(nativePos);
+    const float fade = saturate(1.5f - 2.0f * max(nativeStep.x, nativeStep.y));
+    const float amount = strength * fade;
+    if (amount <= 0.0f) {
+        return color;
+    }
+
+    const float3 lineColor = NativeLineColor(floor(nativePos.y), uv.x);
+
+    // Brighter lines light up a wider beam, like a real electron gun. The
+    // profile is averaged over the pixel's height so it doesn't beat against
+    // the window's pixel grid when the scale isn't a whole number.
+    const float luma = dot(lineColor, float3(0.299f, 0.587f, 0.114f));
+    const float sigma = lerp(0.20f, 0.36f, luma);
+    float scanline = 0.0f;
+    [unroll]
+    for (int i = 0; i < 4; i++) {
+        const float distance = frac(nativePos.y + (float(i) - 1.5f) * 0.25f * nativeStep.y) - 0.5f;
+        scanline += exp(-(distance * distance) / (2.0f * sigma * sigma));
+    }
+
+    scanline *= 0.25f;
+
+    const uint phase = uint(pos.x) % 3;
+    float3 mask = float3(0.82f, 0.82f, 0.82f);
+    mask[phase] = 1.18f;
+
+    const float3 crt = saturate(lineColor * scanline * mask * 1.35f);
+    return lerp(color, crt, amount);
+}
+
 float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
 #ifdef PIXEL_ANTIALIASING
-    return PixelAntialiasing(uv);
+    float4 color = PixelAntialiasing(uv);
 #else
-    return SampleInput((uv / gConstants.textureResolution) * gConstants.videoResolution);
+    float4 color = SampleInput((uv / gConstants.textureResolution) * gConstants.videoResolution);
 #endif
+    color.rgb = ApplyCRT(color.rgb, uv, pos.xy);
+    return color;
 }
