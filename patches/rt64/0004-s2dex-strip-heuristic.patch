+                    // Strip-boundary seam heuristic: rects whose shape/scale implies the game meant
+                    // native-size tiling get point-sampled at native res. Bilinear upscaling at TMEM
+                    // strip boundaries exposes sub-pixel UV drift as visible seams; point-sampling
+                    // quantises it away. GLideN64 ships the same approach (ref: issue #1756).
+                    const int32_t rectW = callDesc.rect.lrx - callDesc.rect.ulx;
+                    const int32_t rectH = callDesc.rect.lry - callDesc.rect.uly;
+                    const int32_t absDsdx = std::abs(int32_t(callDesc.rectDsdx));
+                    const int32_t absDtdy = std::abs(int32_t(callDesc.rectDtdy));
+                    const bool nearIdentityRect = (std::abs(absDsdx - 1024) < 100) && (std::abs(absDtdy - 1024) < 100);
+                    const bool stripShapedRect = (rectH > 0) && (rectH < 128) && (rectW > rectH * 4);
+                    const bool vStripShapedRect = (rectW > 0) && (rectW < 128) && (rectH > rectW * 4);
+                    // Strict strip shape overrides even forced-upscale (All mode): seams appear
+                    // regardless of mode. Near-identity remains ScaledOnly-only — in All mode the
+                    // user has opted into bilinear everywhere, so demoting borderline sprites would
+                    // be an unexpected regression.
+                    const bool demoteStripRect = flags.rect && (stripShapedRect || vStripShapedRect);
+                    const bool treatAsIdentity = callDesc.identityRectScale() || nearIdentityRect || demoteStripRect;
